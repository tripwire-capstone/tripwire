# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Laminar (read by the seed, and by the poller for the key) ---
# Project API key: Laminar → your project → Settings → Project API keys.
LMNR_PROJECT_API_KEY=
# Laminar Cloud (default). For a self-hosted Laminar on this machine, use
# http://host.docker.internal:8000 and http://localhost:5667.
LMNR_API_URL=https://api.lmnr.ai
LMNR_UI_URL=https://laminar.sh
# Optional: the project's ID (from its Laminar URL), for "Open in Laminar" links later.
LMNR_PROJECT_ID=

# --- Placeholder workers ---
# Share of traces that get an event, and of events linked to the seeded cluster.
STUB_EVENT_RATE=0.5
STUB_CLUSTER_RATE=0.5

# --- Optional timing (defaults shown) ---
# POLL_INTERVAL_SECONDS=10
# POLL_SETTLE_SECONDS=15
# POLL_FIRST_RUN_LOOKBACK_HOURS=24
# RUNNER_INTERVAL_SECONDS=5

# --- Clusterer (defaults shown; checked at startup: a bad value stops the clusterer) ---
# placeholder = the skeleton's fixed embeddings; real = assign, group, name, centers.
# Real mode's prepare step is a stand-in until the prepare half lands, so it only clusters
# events that already have embeddings.
# CLUSTERER_MODE=placeholder
# CLUSTERER_INTERVAL_SECONDS=10
# CLUSTER_PREPARE_BATCH=50
# CLUSTER_ASSIGN_THRESHOLD=0.30
# CLUSTER_MIN_EVENTS=3
# CLUSTER_MIN_CONVERSATIONS=2
# CLUSTER_POOL_WINDOW_DAYS=14
# Summarizer (prepare half): the model, and which prompts/summarize_vN files to use.
# SUMMARIZER_MODEL=gpt-6-luna
# SUMMARIZER_PROMPT_VERSION=1
# Health (python -m tripwire.clusterer.health): rule 1 = a live event waiting longer than
# STALL_MINUTES; rule 2 = the last FAILURE_RUN summaries all failed. --alive (for ECS) fails when no
# pass has finished for ALIVE_MINUTES; each pass records its time in LAST_PASS_FILE.
# CLUSTER_HEALTH_STALL_MINUTES=15
# CLUSTER_HEALTH_FAILURE_RUN=10
# CLUSTER_HEALTH_ALIVE_MINUTES=3
# CLUSTERER_LAST_PASS_FILE=/tmp/clusterer-last-pass

# --- Tests (run on your machine, against the compose db) ---
TEST_DATABASE_URL=postgresql://tripwire:tripwire@localhost:5434/tripwire
