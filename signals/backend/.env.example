# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Laminar (read by the seed, and by the poller and runner for the key) ---
# Project API key: Laminar → your project → Settings → Project API keys.
# A key saved on Tripwire's Settings page takes its place; this one is the fallback.
LMNR_PROJECT_API_KEY=
# Laminar Cloud (default). For a self-hosted Laminar on this machine, use
# http://host.docker.internal:8000 and http://localhost:5667.
LMNR_API_URL=https://api.lmnr.ai
LMNR_UI_URL=https://laminar.sh
# Optional: the project's ID (from its Laminar URL), for "Open in Laminar" links. A Laminar key saved
# on the Settings page brings its own project; removing that key goes back to this one.
LMNR_PROJECT_ID=

# --- Settings page (optional) ---
# Only needed to save keys on the Settings page; without it, the keys in this file are used.
# Encrypts saved keys. Make one (64 random hex characters) and paste it here:
#   openssl rand -hex 32
#   (no openssl: python -c "import secrets; print(secrets.token_hex(32))")
# Don't change it later: keys already saved with the old one become unreadable.
TRIPWIRE_SECRET_KEY=

# --- Placeholder workers ---
# Share of traces that get an event, and of events linked to the seeded cluster.
STUB_EVENT_RATE=0.5
STUB_CLUSTER_RATE=0.5

# --- Optional timing (defaults shown) ---
# POLL_INTERVAL_SECONDS=10
# POLL_SETTLE_SECONDS=15
# POLL_FIRST_RUN_LOOKBACK_HOURS=24
# RUNNER_INTERVAL_SECONDS=5

# --- Clusterer (defaults shown; checked at startup: a bad value stops the clusterer) ---
# real = summarize, embed, assign, group, name (calls OpenAI: needs OPENAI_API_KEY below);
# placeholder = the skeleton's fixed embeddings, no OpenAI.
# CLUSTERER_MODE=real
# Judge (runner) and clusterer. A key saved on the Settings page takes its place; this one is the
# fallback. With neither, runs wait and the clusterer skips its OpenAI steps until one is saved.
OPENAI_API_KEY=
# CLUSTERER_INTERVAL_SECONDS=10
# CLUSTER_PREPARE_BATCH=50
# CLUSTER_ASSIGN_THRESHOLD=0.30
# CLUSTER_MIN_EVENTS=3
# CLUSTER_MIN_CONVERSATIONS=2
# CLUSTER_POOL_WINDOW_DAYS=14
# Summarizer (prepare half): the model, and which prompts/summarize_vN files to use.
# SUMMARIZER_MODEL=gpt-6-luna
# SUMMARIZER_PROMPT_VERSION=4
# Health (python -m tripwire.clusterer.health): rule 1 = a live event waiting longer than
# STALL_MINUTES; rule 2 = the last FAILURE_RUN summaries all failed. --alive (for ECS) fails when no
# pass has finished for ALIVE_MINUTES; each pass records its time in LAST_PASS_FILE.
# CLUSTER_HEALTH_STALL_MINUTES=15
# CLUSTER_HEALTH_FAILURE_RUN=10
# CLUSTER_HEALTH_ALIVE_MINUTES=3
# CLUSTERER_LAST_PASS_FILE=/tmp/clusterer-last-pass
# Cluster naming (step 4, SIG-65): the model that names clusters, or "off" for the old naming
# (each cluster named after its most typical member's summary, no LLM call). A cluster is renamed
# when its member count reaches RENAME_GROWTH x its size when last named; at most
# MAX_RENAMES_PER_PASS renames per pass (0 = never rename).
# NAMING_MODEL=gpt-6.1-sol
# NAMING_RENAME_GROWTH=2.0
# NAMING_MAX_RENAMES_PER_PASS=10

# --- Tests (run on your machine, against the compose db) ---
TEST_DATABASE_URL=postgresql://tripwire:tripwire@localhost:5434/tripwire

# --- API and seed ---
# Judge model for a fresh seed and for API definitions that omit the model.
JUDGE_DEFAULT_MODEL=gpt-6-luna

# --- Slack notifications ---
# The webhook is encrypted with TRIPWIRE_SECRET_KEY (Settings page section above): set that first.
# Optional: read by `python -m tripwire.slack_setup connect` when no URL is passed.
# TRIPWIRE_SLACK_WEBHOOK_URL=
# TRIPWIRE_SLACK_POLL_INTERVAL_SECONDS=15
# Where Slack alerts link to (the Tripwire UI as your teammates reach it).
# TRIPWIRE_UI_URL=http://localhost:5174
