# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Laminar (read by the seed, and by the poller for the key) ---
# Project API key: Laminar → your project → Settings → Project API keys.
LMNR_PROJECT_API_KEY=
# Laminar Cloud (default). For a self-hosted Laminar on this machine, use
# http://host.docker.internal:8000 and http://localhost:5667.
LMNR_API_URL=https://api.lmnr.ai
LMNR_UI_URL=https://laminar.sh
# Optional: the project's ID (from its Laminar URL), for "Open in Laminar" links later.
LMNR_PROJECT_ID=

# --- Placeholder workers ---
# Share of traces that get an event, and of events linked to the seeded cluster.
STUB_EVENT_RATE=0.5
STUB_CLUSTER_RATE=0.5

# --- Optional timing (defaults shown) ---
# POLL_INTERVAL_SECONDS=10
# POLL_SETTLE_SECONDS=15
# POLL_FIRST_RUN_LOOKBACK_HOURS=24
# RUNNER_INTERVAL_SECONDS=5
# CLUSTERER_INTERVAL_SECONDS=10

# --- Tests (run on your machine, against the compose db) ---
TEST_DATABASE_URL=postgresql://tripwire:tripwire@localhost:5434/tripwire
