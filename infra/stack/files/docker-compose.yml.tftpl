# Rendered by Terraform. A doubled dollar sign is left for Docker Compose to fill in from .env
services:
  clickhouse:
    image: ${clickhouse_image}
    restart: unless-stopped
    ports:
      - "8123:8123"
    environment:
      CLICKHOUSE_USER: ${clickhouse_user}
      CLICKHOUSE_PASSWORD: $${CLICKHOUSE_PASSWORD}
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - /data/clickhouse:/var/lib/clickhouse
      - /data/clickhouse-logs:/var/log/clickhouse-server
      - ./clickhouse-profiles-config.xml:/etc/clickhouse-server/users.d/lmnr.xml:ro
      - ./clickhouse-server-config.xml:/etc/clickhouse-server/config.d/lmnr.xml:ro
      - ./clickhouse-compat-config.xml:/etc/clickhouse-server/users.d/compat.xml:ro
      - ./clickhouse-merge-tree-config.xml:/etc/clickhouse-server/config.d/merge-tree.xml:ro

  quickwit:
    image: ${quickwit_image}
    restart: unless-stopped
    command: ["run"]
    ports:
      - "7280:7280"
      - "7281:7281"
    environment:
      QW_DATA_DIR: /quickwit/qwdata
      QW_DISABLE_TELEMETRY: "1"
    volumes:
      - /data/quickwit:/quickwit/qwdata