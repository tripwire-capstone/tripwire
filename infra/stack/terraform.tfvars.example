# Days of automated RDS backups. Free-plan AWS accounts are capped: use 1 there.
# db_backup_retention_days = 7

# Restore the database from an earlier teardown's final snapshot (first create only)
# db_snapshot_identifier = "tripwire-db-final-3f9a2c"

# 4 GB minimum. Free-plan accounts: c7i-flex.large
# data_instance_type = "t4g.medium"

# Restore the data volume from an earlier teardown's final snapshot (first create only)
# data_volume_snapshot_id = "snap-0123456789abcdef0"

# Emails allowed to log in to the Laminar UI; each gets a temporary password by email
# laminar_users = ["you@example.com"]

# Scheduled snapshots of the data volume: how often, and how many to keep
# data_snapshot_interval_hours        = 1
# data_snapshot_retention_count       = 24
# data_snapshot_daily_retention_count = 7

# Gets an email when a scheduled data volume snapshot fails
# alert_email = "you@example.com"
