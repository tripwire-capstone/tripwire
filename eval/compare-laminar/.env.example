# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Fill these in after the wizard's manual setup steps (fresh Laminar project + signals).

# --- Laminar (the fresh project created for this comparison) ---
LMNR_PROJECT_API_KEY=
LMNR_API_URL=https://api.lmnr.ai
LMNR_UI_URL=https://laminar.sh
LMNR_PROJECT_ID=

# --- Tripwire (same var name the backend tests use) ---
TEST_DATABASE_URL=postgresql://tripwire:tripwire@localhost:5434/tripwire
# Where the Tripwire API is reachable, to poll /api/dev/status for settle detection.
TRIPWIRE_API_URL=http://localhost:8080

# --- Traffic (point at the existing generators; see their own READMEs) ---
PARK_TRAFFIC_DIR=~/projects/park-traffic
TAU_TRAFFIC_DIR=../../traffic/tau-bench
